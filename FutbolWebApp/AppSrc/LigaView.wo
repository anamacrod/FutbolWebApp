Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cligaDataDictionary.dd

Object oLigaView is a cWebView
    Set piWidth to 700
    Set psCaption to "LigaView"
    Set peLayoutType to ltGrid
    Set piColumnCount to 2
    Set piRowCount to 1
    Set peViewType to vtSelect

    Object oLiga_DD is a cligaDataDictionary
    End_Object
    
    Set Main_DD to oLiga_DD
    Set Server to oLiga_DD

    Object oWebGrid1 is a cWebList
        Set Server to oLiga_DD
        Set piColumnSpan to 2
        
       // sprint 2// 
       
        Set pbServerOnRowClick to True
        WebRegisterPath ntNavigateForward oLigaZoomView

        Procedure OnRowClick String sRowID Integer iColumnIndex
            String sCurrentRowID
            tWebNavigateData NavigateData

            WebGet psCurrentRowID to sCurrentRowID
            If (sRowID = "" or sRowID <> sCurrentRowID) Procedure_Return

            Get GetNavigateData of oLigaView to NavigateData
            If (NavigateData.eNavigateType = nfFromChild) Begin
                Send NavigateClose of oLigaView Self
                Procedure_Return
            End

            Send NavigatePath
        End_Procedure
        
        //
        Object oWebColumn1 is a cWebColumn
            Entry_Item liga.ID
            Set psCaption to "ID"
        End_Object
        
        Object oWebColumn2 is a cWebColumn
            Entry_Item liga.Nombre
            Set psCaption to "Nombre"
        End_Object
        
        Object oWebColumn3 is a cWebColumn
            Entry_Item liga.Pais
            Set psCaption to "Pais"
        End_Object
        
        Object oWebColumn4 is a cWebColumn
            Entry_Item liga.Equipos
            Set psCaption to "Equipos"
        End_Object
        
        Object oWebColumn5 is a cWebColumn
            Entry_Item liga.EquiposMax
            Set psCaption to "EquiposMax"
        End_Object
    End_Object
    
End_Object