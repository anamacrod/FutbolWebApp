Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cposicionDataDictionary.dd

Object oPosicionZoomView is a cWebView
    Set piWidth to 600
    Set psCaption to "Ficha de Posición (Mantenimiento)"
    Set peLayoutType to ltGrid
    Set piColumnCount to 12

    // Declaración del Diccionario de Datos de Posición
    Object oPosicion_DD is a cposicionDataDictionary
    End_Object
    
    Set Main_DD to oPosicion_DD
    Set Server to oPosicion_DD

    // Panel principal con los campos de entrada para posiciones
    Object oWebMainPanel is a cWebPanel
        Set peLayoutType to ltGrid
        Set piColumnCount to 12
        Set piColumnSpan to 12

        Object oIdForm is a cWebForm
            Entry_Item posicion.ID
            Set psCaption to "ID:"
            Set piColumnSpan to 4
            Set pbEnabled to False
        End_Object

        Object oNombreForm is a cWebForm
            Entry_Item posicion.Nombre
            Set psCaption to "Nombre de Posición:"
            Set piColumnSpan to 8
        End_Object
    End_Object

End_Object