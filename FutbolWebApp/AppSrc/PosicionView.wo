Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebGrid.pkg
Use cWebColumn.pkg
Use cposicionDataDictionary.dd

Object oPosicionView is a cWebView
    Set piWidth to 700
    Set psCaption to "PosicionView"
    Set peLayoutType to ltGrid
    Set piColumnCount to 2
    Set piRowCount to 1
    
    Object oPosicion_DD is a cposicionDataDictionary
    End_Object
    
    Set Main_DD to oPosicion_DD
    Set Server to oPosicion_DD

    Object oWebGrid1 is a cWebGrid
        Set Server to oPosicion_DD
        Set piColumnSpan to 2
        
        Object oWebColumn1 is a cWebColumn
            Entry_Item posicion.ID
            Set psCaption to "ID"
        End_Object
        
        Object oWebColumn2 is a cWebColumn
            Entry_Item posicion.Nombre
            Set psCaption to "Nombre"
        End_Object
    End_Object

End_Object