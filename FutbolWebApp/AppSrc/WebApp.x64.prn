36913>>>>>    //
36913>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
36913>>>>>    // update properties based on the session and user data. Augment this function to update 
36913>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
36913>>>>>    // the right records when this procedure is called.
36913>>>>>    //
36913>>>>>    // Params:
36913>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
36913>>>>>    //
36913>>>>>    Procedure UpdateSessionProperties Boolean bClear
36915>>>>>        Handle hoUserDD
36915>>>>>        
36915>>>>>        Get phoUserDD to hoUserDD
36916>>>>>        
36916>>>>>        //  Update user properties
36916>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
36918>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
36919>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
36920>>>>>            Set piUserRights to WebAppUser.Rights
36921>>>>>            
36921>>>>>            Send OnSessionPropertiesSet 
36922>>>>>        End
36922>>>>>>
36922>>>>>        Else Begin
36923>>>>>            Set psUsername to ""
36924>>>>>            Set psLoginName to ""
36925>>>>>            Set piUserRights to 0
36926>>>>>            
36926>>>>>            Send OnSessionPropertiesClear
36927>>>>>        End
36927>>>>>>
36927>>>>>    End_Procedure
36928>>>>>    
36928>>>>>    Procedure OnSessionPropertiesSet
36930>>>>>        //  Empty event stub
36930>>>>>    End_Procedure
36931>>>>>    
