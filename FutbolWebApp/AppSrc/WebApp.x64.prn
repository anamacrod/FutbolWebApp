36578>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36580>>>>>>>        Boolean bRequireTimeCost
36580>>>>>>>        UBigInt ullSize
36580>>>>>>>        UChar[] ucaSalt
36581>>>>>>>        String sSalt
36581>>>>>>>        
36581>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36582>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36583>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36586>>>>>>>        
36586>>>>>>>        Case Begin
36586>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36588>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36589>>>>>>>                Move True to bRequireTimeCost
36590>>>>>>>                Case Break
36591>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36594>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36595>>>>>>>                Move True to bRequireTimeCost
36596>>>>>>>                Case Break
36597>>>>>>>            Case Else
36597>>>>>>>                Error 8710 "Invalid algorithm selected."
36598>>>>>>>>
36598>>>>>>>                Function_Return 0
36599>>>>>>>        Case End
36599>>>>>>>        
36599>>>>>>>        // calculate base64 in a non-floating-manner
36599>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36600>>>>>>>        
36600>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36601>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36602>>>>>>>        If (bRequireTimeCost) Begin
36604>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36605>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36606>>>>>>>        End
36606>>>>>>>>
36606>>>>>>>        Else Begin
36607>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36608>>>>>>>        End
36608>>>>>>>>
36608>>>>>>>        
36608>>>>>>>        Function_Return ullSize
36609>>>>>>>    End_Function
