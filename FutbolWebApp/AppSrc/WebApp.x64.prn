36526>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36528>>>>>>>        Boolean bRequiresTimeCost
36528>>>>>>>        UInteger uiAlgo uiTimeCost
36528>>>>>>>        Integer iBegin iEnd
36528>>>>>>>        String sSalt
36528>>>>>>>        
36528>>>>>>>        Move 1 to iBegin
36529>>>>>>>        
36529>>>>>>>        // Parse Algo
36529>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36530>>>>>>>        If (not(iEnd)) Function_Return False
36533>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36534>>>>>>>        
36534>>>>>>>        // Parse Salt
36534>>>>>>>        Move (iEnd + 1) to iBegin
36535>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36536>>>>>>>        If (not(iEnd)) Function_Return False
