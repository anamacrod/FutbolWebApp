37073>>>        Get StateHash of ghoWebApp to sPrevStateHash
37074>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37075>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37077>>>            WebSet psPrevStateHash to sPrevStateHash
37078>>>        End
37078>>>>
37078>>>        
37078>>>    End_Procedure
