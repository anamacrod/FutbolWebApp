36836>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
36838>>>>>        String sSessionKey sUserPassword
36838>>>>>        Handle hoSessionDD hoUserDD
36838>>>>>        Boolean bMatch bUpgrade
36838>>>>>        
36838>>>>>        Get phoSessionDD to hoSessionDD
36839>>>>>        Get phoUserDD to hoUserDD
36840>>>>>        Integer iErr eLoginMode
36840>>>>>        
36840>>>>>        // Refind session record
36840>>>>>        Get psSessionKey to sSessionKey
36841>>>>>        Send Clear of hoSessionDD
36842>>>>>        Move sSessionKey to WebAppSession.SessionKey
36843>>>>>        Send Find of hoSessionDD EQ Index.1
36844>>>>>        
36844>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
36846>>>>>            Get peLoginMode to eLoginMode
36847>>>>>            
36847>>>>>            //  Find the user
36847>>>>>            Move sLoginName to WebAppUser.LoginName
36848>>>>>            Send Find of hoUserDD EQ Index.1
36849>>>>>            
36849>>>>>            // Check username and password
36849>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
36851>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
36852>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
36853>>>>>                
36853>>>>>                If (bMatch) Begin
36855>>>>>                    // Store the login
36855>>>>>                    If (bUpgrade) Begin
36857>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
36858>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
36861>>>>>                    End
36861>>>>>>
36861>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
36862>>>>>                    Get Request_Validate of hoSessionDD to iErr
36863>>>>>                    If (iErr) Begin
36865>>>>>                        // this should not happen. If it does its a programming error
36865>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36866>>>>>>
36866>>>>>                        Function_Return False
36867>>>>>                    End
36867>>>>>>
36867>>>>>                    
36867>>>>>                    Send Request_Save of hoSessionDD
36868>>>>>                    
36868>>>>>                    // Update session properties
36868>>>>>                    Send UpdateSessionProperties False
36869>>>>>                    Send NotifyChangeRights
36870>>>>>                    Function_Return True
36871>>>>>                End
36871>>>>>>
36871>>>>>                Else Begin
36872>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
36872>>>>>                    Send Clear of hoUserDD
36873>>>>>                End
36873>>>>>>
36873>>>>>            End
36873>>>>>>
36873>>>>>            Else Begin
36874>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
36874>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
36875>>>>>            End
36875>>>>>>
36875>>>>>        End
36875>>>>>>
36875>>>>>        Else Begin
36876>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
36876>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
36877>>>>>        End
36877>>>>>>
36877>>>>>          
36877>>>>>        Function_Return False
36878>>>>>    End_Function
