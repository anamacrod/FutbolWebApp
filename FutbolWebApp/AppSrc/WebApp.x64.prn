36542>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36545>>>>>>>                Move True to bRequiresTimeCost
36546>>>>>>>                Case Break
36547>>>>>>>            Case Else
36547>>>>>>>                Error 8710 "Invalid algorithm selected."
36548>>>>>>>>
36548>>>>>>>                Function_Return False
36549>>>>>>>        Case End
36549>>>>>>>        
36549>>>>>>>        // Parse optional timecost
36549>>>>>>>        If (bRequiresTimeCost) Begin
36551>>>>>>>            Move (iEnd + 1) to iBegin
36552>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36553>>>>>>>            If (not(iEnd)) Function_Return False
36556>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36557>>>>>>>        End
36557>>>>>>>>
36557>>>>>>>        
36557>>>>>>>        // Parse rest hash
36557>>>>>>>        Move (iEnd + 1) to iBegin
36558>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36559>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36562>>>>>>>        
36562>>>>>>>        // Base64Decode
36562>>>>>>>        UChar[] ucaSalt
36563>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36564>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36567>>>>>>>        
36567>>>>>>>        // Create new hash
36567>>>>>>>        String sNewHash
36567>>>>>>>        If (bRequiresTimeCost) Begin
36569>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36571>>>>>>>                Function_Return False 
36572>>>>>>>            End
36572>>>>>>>>
36572>>>>>>>        End
36572>>>>>>>>
36572>>>>>>>        Else Begin
36573>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36575>>>>>>>                Function_Return False 
36576>>>>>>>            End
36576>>>>>>>>
36576>>>>>>>        End
36576>>>>>>>>
36576>>>>>>>        Function_Return (sNewHash = sHash)
