36712>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36714>>>>>        DateTime dtLastAccess dtCurrent
36714>>>>>        TimeSpan tsDiff
36714>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36714>>>>>        Boolean bResult bCreatingNewSession
36714>>>>>        Boolean bLogWebSession bLoadWebApp
36714>>>>>        Integer eLoginMode
36714>>>>>        String sTime
36714>>>>>        Handle hoSessionDD hoUserDD       
36714>>>>>        
36714>>>>>        Move False to bLoadWebApp
36715>>>>>        If (num_arguments >= 2) Begin
36717>>>>>            Move bOptLoadWebApp to bLoadWebApp
36718>>>>>        End
36718>>>>>>
36718>>>>>        
36718>>>>>        Get phoSessionDD to hoSessionDD
36719>>>>>        Get phoUserDD to hoUserDD
36720>>>>>        
36720>>>>>        Get pbLogWebSession to bLogWebSession
36721>>>>>        Get peLoginMode to eLoginMode
36722>>>>>        
36722>>>>>        // for this object, you can only disable logging if login completely is disabled
36722>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36724>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36725>>>>>>
36725>>>>>            Function_Return False
36726>>>>>        End
36726>>>>>>
36726>>>>>
36726>>>>>        //  Clear session properties
36726>>>>>        Set psSessionKey to ""
36727>>>>>        Send UpdateSessionProperties True
36728>>>>>        
36728>>>>>        If not bLogWebSession Begin
36730>>>>>            Forward Get ValidateSession sSessionKey to bResult
36732>>>>>            Function_Return bResult
36733>>>>>        End        
36733>>>>>>
36733>>>>>        
36733>>>>>        Move False to bResult
36734>>>>>        Get piSessionTimeout to iSessionTimeout 
36735>>>>>        
36735>>>>>        //  Check if session exists
36735>>>>>        Send Clear of hoSessionDD
36736>>>>>        Move sSessionKey to WebAppSession.SessionKey
36737>>>>>        Send Find of hoSessionDD EQ Index.1
36738>>>>>            
36738>>>>>        If (Found) Begin
36740>>>>>            //  Calculate timespan between now and last access time
36740>>>>>            Move (CurrentDateTime()) to dtCurrent
36741>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36742>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36743>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36744>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36745>>>>>            
36745>>>>>            //  Check if session didn't time out
36745>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36747>>>>>                Forward Get ValidateSession sSessionKey to bResult
36749>>>>>                   
36749>>>>>                If (bResult) Begin
36751>>>>>                    //  Update session record
36751>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36752>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36753>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36754>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36755>>>>>                    Get Request_Validate of hoSessionDD to iErr
36756>>>>>                    If (iErr) Begin
36758>>>>>                        // this should not happen. If it does its a programming error
36758>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36759>>>>>>
36759>>>>>                        Function_Return False
36760>>>>>                    End
36760>>>>>>
36760>>>>>                    Send Request_Save of hoSessionDD
36761>>>>>                    
36761>>>>>                    //  Update user properties
36761>>>>>                    Send UpdateSessionProperties False
36762>>>>>                End
36762>>>>>>
36762>>>>>            End
36762>>>>>>
36762>>>>>            Else Begin
36763>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36763>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36764>>>>>                
36764>>>>>                If (not(bCreatingNewSession)) Begin
36766>>>>>                    If (not(bLoadWebApp)) Begin
36768>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36769>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36770>>>>>>
36770>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36771>>>>>                    End
36771>>>>>>
36771>>>>>                    Else Begin
36772>>>>>                        Set pbCreatingNewSession to True                    
36773>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36774>>>>>                        Set pbCreatingNewSession to False                        
36775>>>>>                    End
36775>>>>>>
36775>>>>>                End
36775>>>>>>
36775>>>>>            End
36775>>>>>>
36775>>>>>        End
36775>>>>>>
36775>>>>>        Else Begin
36776>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36777>>>>>>
36777>>>>>        End
36777>>>>>>
36777>>>>>        
36777>>>>>        Function_Return bResult
36778>>>>>    End_Function
