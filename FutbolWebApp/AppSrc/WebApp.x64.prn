36779>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36781>>>>>        If (not(pbPasswordHashing(Self))) Begin
36783>>>>>            Move sPassword to sHash
36784>>>>>            Function_Return True
36785>>>>>        End
36785>>>>>>
36785>>>>>        
36785>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36787>>>>>            Function_Return False
36788>>>>>        End
36788>>>>>>
36788>>>>>        Move ("V1$" + sHash) to sHash
36789>>>>>        Function_Return True
36790>>>>>    End_Function
36791>>>>>    
36791>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
36793>>>>>        If (not(pbPasswordHashing(Self))) Begin
36795>>>>>            Move False to bShouldUpgrade
36796>>>>>            Function_Return (sUserPassword = sEnteredPassword)
36797>>>>>        End
36797>>>>>>
36797>>>>>        
36797>>>>>        String sVersion
36797>>>>>        Move (Left(sUserPassword, 3)) to sVersion
36798>>>>>        If (sVersion = "V1$") Begin
36800>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
36803>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
36804>>>>>        End
36804>>>>>>
36804>>>>>        Else Begin
36805>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
36808>>>>>            Function_Return False
36809>>>>>        End
36809>>>>>>
36809>>>>>    End_Function
