37704>>>>>Class cLoginEncryption is a cObject
37705>>>>>    
37705>>>>>    Procedure Construct_Object
37707>>>>>        Forward Send Construct_Object
37709>>>>>        // this must be set to a multi (40ish) character random key
37709>>>>>        Property String psEncryptPassword ""
37710>>>>>        
37710>>>>>        Object oDataCrypter is a cCryptographerEx
37712>>>>>            Set piHash to CALG_SHA_256
37713>>>>>            Set piCipher to CALG_AES_256
37714>>>>>            Set psProvider to "" //  Not providing a specific provider gives the default provider for the provider type
37715>>>>>            Set piProvider to PROV_RSA_AES
37716>>>>>        End_Object
37717>>>>>    End_Procedure
37718>>>>>    
37718>>>>>    // This can be augmented to return a password encryption key using any
37718>>>>>    // hidden mechanism desired.
37718>>>>>    Function GetEncryptionPassword Returns String
37720>>>>>        String sPassword
37720>>>>>        Get psEncryptPassword to sPassword
37721>>>>>        Function_Return sPassword
37722>>>>>    End_Function
37723>>>>>    
37723>>>>>    // Encrypts a string into an unreadable hash that can later be decrypted using DecryptKey.
37723>>>>>    //
37723>>>>>    // Params:
37723>>>>>    //   sPlainText     String to encrypt.
37723>>>>>    // Returns:
37723>>>>>    //   Base64 encoded hash.
37723>>>>>    Function EncryptPassword String sPlainText Returns String
37725>>>>>        String sEncryptPassword sBase64
37725>>>>>        UChar[] ucBinary
37726>>>>>        Pointer pBase64
37726>>>>>        Integer iVoid
37726>>>>>        
37726>>>>>        //  Encrypt Key
37726>>>>>        Get GetEncryptionPassword to sEncryptPassword
37727>>>>>        If (sEncryptPassword = "") Begin
37729>>>>>            Error DFERR_PROGRAM "No encryption password set"
37730>>>>>>
37730>>>>>        End
37730>>>>>>
37730>>>>>        
37730>>>>>        Get Encrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) (StringToUCharArray(sPlainText)) to ucBinary
37731>>>>>        
37731>>>>>        If (SizeOfArray(ucBinary) = 0) Begin
37733>>>>>            Error DFERR_PROGRAM "Unable to encrypt database login password"
37734>>>>>>
37734>>>>>            Function_Return ""
37735>>>>>        End
37735>>>>>>
37735>>>>>        
37735>>>>>        //  Encode binary hash to Base64
37735>>>>>        Move (Base64Encode(AddressOf(ucBinary), SizeOfArray(ucBinary))) to pBase64
37736>>>>>        Move (PointerToString(pBase64)) to sBase64
37737>>>>>        Move (Free(pBase64)) to iVoid
37738>>>>>        
37738>>>>>        Function_Return sBase64
37739>>>>>    End_Function
37740>>>>>    
37740>>>>>    
37740>>>>>    // Decrypts the unreadable hash generated by EncryptKey into a readable string.
37740>>>>>    //
37740>>>>>    // Params:
37740>>>>>    //   sBase64EncryptedPassword       Base64 Encrypted password
37740>>>>>    // Returns:
37740>>>>>    //   Readable plain text password
37740>>>>>    Function DecryptPassword String sBase64EncryptedPassword Returns String
37742>>>>>        String sEncryptPassword
37742>>>>>        UChar[] ucBinary ucPlain
37744>>>>>        Boolean bIsHex
37744>>>>>        Integer iLen iVoid
37744>>>>>        Pointer pBinary
37744>>>>>        
37744>>>>>        If (sBase64EncryptedPassword <> "") Begin
37746>>>>>            //  Decode from Base64
37746>>>>>            Move (Base64Decode(AddressOf(sBase64EncryptedPassword), &iLen)) to pBinary
37747>>>>>            
37747>>>>>            Move (ResizeArray(ucBinary, iLen, 0)) to ucBinary
37748>>>>>            Move (MemCopy(AddressOf(ucBinary), pBinary, iLen)) to iVoid
37749>>>>>                        
37749>>>>>            Move (Free(pBinary)) to iVoid
37750>>>>>            
37750>>>>>            //  Encrypted binary hash to string
37750>>>>>            Get GetEncryptionPassword to sEncryptPassword
37751>>>>>            Get Decrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) ucBinary to ucPlain
37752>>>>>        End
37752>>>>>>
37752>>>>>        
37752>>>>>        Function_Return (UCharArrayToString(ucPlain))
37753>>>>>    End_Function
37754>>>>>End_Class
