37044>>>    Procedure DoLogin
37047>>>        String sLoginName sPassword sPrevStateHash
37047>>>        Boolean bResult
37047>>>        
37047>>>        WebGet psValue of oLoginName to sLoginName
37048>>>        WebGet psValue of oPassword to sPassword
37049>>>        
37049>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37050>>>        
37050>>>        If (bResult) Begin
37052>>>            Send Hide of oLogin
37053>>>            Send ShowHeader of ghoWebApp
37054>>>            WebSet psCSSClass of ghoWebApp to ""
37055>>>            
37055>>>            WebGet psPrevStateHash to sPrevStateHash
37056>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37057>>>            
37057>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37057>>>            WebSet psValue of oLoginName to ""
37058>>>            WebSet psValue of oPassword  to ""
37059>>>            WebSet pbVisible of oWarning to False
37060>>>        End
37060>>>>
37060>>>        Else Begin
37061>>>            WebSet pbVisible of oWarning to True
37062>>>        End
37062>>>>
37062>>>    End_Procedure
