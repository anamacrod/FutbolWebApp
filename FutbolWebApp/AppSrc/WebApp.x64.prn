36641>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36643>>>>>>>                Function_Return False 
36644>>>>>>>            End
36644>>>>>>>>
36644>>>>>>>        End
36644>>>>>>>>
36644>>>>>>>        Else Begin
36645>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36647>>>>>>>                Function_Return False 
36648>>>>>>>            End
36648>>>>>>>>
36648>>>>>>>        End
36648>>>>>>>>
36648>>>>>>>        Function_Return (sNewHash = sHash)
36649>>>>>>>    End_Function
36650>>>>>>>    
36650>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36652>>>>>>>        Boolean bRequireTimeCost
36652>>>>>>>        UBigInt ullSize
36652>>>>>>>        UChar[] ucaSalt
36653>>>>>>>        String sSalt
36653>>>>>>>        
36653>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36654>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36655>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36658>>>>>>>        
36658>>>>>>>        Case Begin
36658>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36660>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36661>>>>>>>                Move True to bRequireTimeCost
36662>>>>>>>                Case Break
36663>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36666>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36667>>>>>>>                Move True to bRequireTimeCost
36668>>>>>>>                Case Break
36669>>>>>>>            Case Else
36669>>>>>>>                Error 8710 "Invalid algorithm selected."
36670>>>>>>>>
36670>>>>>>>                Function_Return 0
36671>>>>>>>        Case End
36671>>>>>>>        
36671>>>>>>>        // calculate base64 in a non-floating-manner
36671>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36672>>>>>>>        
36672>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36673>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36674>>>>>>>        If (bRequireTimeCost) Begin
36676>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36677>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36678>>>>>>>        End
36678>>>>>>>>
36678>>>>>>>        Else Begin
36679>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36680>>>>>>>        End
36680>>>>>>>>
36680>>>>>>>        
36680>>>>>>>        Function_Return ullSize
36681>>>>>>>    End_Function
36682>>>>>>>End_Class
36683>>>>>>>
36683>>>>>>>Class cPasswordHasher is a cObject
36684>>>>>>>    
36684>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36685>>>>>>>    
36685>>>>>>>    Procedure Construct_Object
36687>>>>>>>        Forward Send Construct_Object
36689>>>>>>>        
36689>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36690>>>>>>>        Property UInteger   puiSaltSize         16
36691>>>>>>>        
36691>>>>>>>        Property UInteger   puiOptTimeCost      420000
36692>>>>>>>    End_Procedure
36693>>>>>>>    
36693>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36695>>>>>>>        Boolean bOk
36695>>>>>>>        UInteger uiAlgo
36695>>>>>>>        Get peAlgorithm to uiAlgo
36696>>>>>>>        
36696>>>>>>>        Case Begin
36696>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36698>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36701>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36702>>>>>>>                Case Break
36703>>>>>>>            Case Else
36703>>>>>>>                Error 8710 "Invalid algorithm selected."
36704>>>>>>>>
36704>>>>>>>                Function_Return False
36705>>>>>>>        Case End
36705>>>>>>>        
36705>>>>>>>        Function_Return bOk
36706>>>>>>>    End_Function
36707>>>>>>>    
36707>>>>>>>    Function RequiredBufferSize Returns UBigInt
36709>>>>>>>        UBigInt ullSize
36709>>>>>>>        UInteger uiAlgo
36709>>>>>>>        Get peAlgorithm to uiAlgo
36710>>>>>>>        
36710>>>>>>>        Case Begin
36710>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36712>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36715>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36716>>>>>>>                Case Break
36717>>>>>>>            Case Else
36717>>>>>>>                Error 8710 "Invalid algorithm selected."
36718>>>>>>>>
36718>>>>>>>                Function_Return 0
36719>>>>>>>        Case End
36719>>>>>>>        
36719>>>>>>>        Function_Return ullSize
36720>>>>>>>    End_Function
36721>>>>>>>
36721>>>>>>>End_Class
