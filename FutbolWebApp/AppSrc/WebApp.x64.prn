36336>>>>>>>    //
36336>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36336>>>>>>>    //
36336>>>>>>>    //  Params:
36336>>>>>>>    //      dtTime  Time to convert
36336>>>>>>>    //  Returns:
36336>>>>>>>    //      String with "HH:MM:SS" format
36336>>>>>>>    //
36336>>>>>>>    Function TimeToString DateTime dtTime Returns String
36338>>>>>>>        String sHours sMinutes sSeconds
36338>>>>>>>        
36338>>>>>>>        //  Extract parts
36338>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36339>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36340>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36341>>>>>>>        
36341>>>>>>>        //  Fill out with 0
36341>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36344>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36347>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36350>>>>>>>        
36350>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36351>>>>>>>    End_Function
