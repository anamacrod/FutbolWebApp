36690>>>>>        
36690>>>>>        //  Get session key
36690>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36692>>>>>        
36692>>>>>        Get pbLogWebSession to bLogWebSession
36693>>>>>        If not bLogWebSession Begin
36695>>>>>            Function_Return sSessionKey        
36696>>>>>        End
36696>>>>>>
36696>>>>>
36696>>>>>        //  Store session
36696>>>>>        Send Clear of hoSessionDD
36697>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36698>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36699>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36700>>>>>        Get Request_Validate of hoSessionDD to iErr
36701>>>>>        If (iErr) Begin
36703>>>>>            // this should not happen. If it does its a programming error
36703>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36704>>>>>>
36704>>>>>            Function_Return ""
36705>>>>>        End
36705>>>>>>
36705>>>>>        Send Request_Save of hoSessionDD
36706>>>>>        If (Err) Begin
36708>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36708>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36709>>>>>>
36709>>>>>            Function_Return ""
36710>>>>>        End
36710>>>>>>
36710>>>>>       
36710>>>>>        Function_Return sSessionKey        
