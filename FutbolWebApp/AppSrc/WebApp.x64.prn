36722>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36723>>>>>    
36723>>>>>    Procedure Construct_Object
36725>>>>>        Handle hoObj
36725>>>>>        
36725>>>>>        Forward Send Construct_Object
36727>>>>>        
36727>>>>>        Set pbSessionCookieHttpOnly to True
36728>>>>>        
36728>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36729>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36730>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36731>>>>>        
36731>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36732>>>>>        Set phoUserDD to hoObj
36733>>>>>        
36733>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
36734>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
36735>>>>>        Set phoSessionDD to hoObj
36736>>>>>        
36736>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
36737>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
36738>>>>>        Set phoCrypto to hoObj
36739>>>>>        
36739>>>>>        Property Boolean pbPasswordHashing True
36740>>>>>        
36740>>>>>        Property Boolean pbCreatingNewSession False
36741>>>>>        Property String psLoginName
36742>>>>>        Property String psUserName ""
36743>>>>>        Property Integer piUserRights 0
36744>>>>>    End_Procedure
36745>>>>>    
36745>>>>>    Procedure End_Construct_Object
36747>>>>>        Forward Send End_Construct_Object
36749>>>>>        
36749>>>>>        Handle hoCrypto
36749>>>>>        Integer iFieldLen
36749>>>>>        If (pbPasswordHashing(Self)) Begin
36751>>>>>            Get phoCrypto to hoCrypto
36752>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
36755>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
36757>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
36758>>>>>>
36758>>>>>            End
36758>>>>>>
36758>>>>>        End
36758>>>>>>
36758>>>>>    End_Procedure
36759>>>>>    
36759>>>>>    Function CreateSession String sRemoteAddress Returns String
36761>>>>>        String sSessionKey
36761>>>>>        Integer iErr
36761>>>>>        Boolean bLogWebSession
36761>>>>>        Handle hoSessionDD       
36761>>>>>        Get phoSessionDD to hoSessionDD
36762>>>>>        
36762>>>>>        //  Get session key
36762>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
36764>>>>>        
36764>>>>>        Get pbLogWebSession to bLogWebSession
36765>>>>>        If not bLogWebSession Begin
36767>>>>>            Function_Return sSessionKey        
36768>>>>>        End
36768>>>>>>
36768>>>>>
36768>>>>>        //  Store session
36768>>>>>        Send Clear of hoSessionDD
36769>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
36770>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
36771>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
36772>>>>>        Get Request_Validate of hoSessionDD to iErr
36773>>>>>        If (iErr) Begin
36775>>>>>            // this should not happen. If it does its a programming error
36775>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36776>>>>>>
36776>>>>>            Function_Return ""
36777>>>>>        End
36777>>>>>>
36777>>>>>        Send Request_Save of hoSessionDD
36778>>>>>        If (Err) Begin
36780>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
36780>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
36781>>>>>>
36781>>>>>            Function_Return ""
36782>>>>>        End
36782>>>>>>
36782>>>>>       
36782>>>>>        Function_Return sSessionKey        
36783>>>>>    End_Function
36784>>>>>    
36784>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
36786>>>>>        DateTime dtLastAccess dtCurrent
36786>>>>>        TimeSpan tsDiff
36786>>>>>        Integer iErr iSessionTimeout iSpanMinutes
36786>>>>>        Boolean bResult bCreatingNewSession
36786>>>>>        Boolean bLogWebSession bLoadWebApp
36786>>>>>        Integer eLoginMode
36786>>>>>        String sTime
36786>>>>>        Handle hoSessionDD hoUserDD       
36786>>>>>        
36786>>>>>        Move False to bLoadWebApp
36787>>>>>        If (num_arguments >= 2) Begin
36789>>>>>            Move bOptLoadWebApp to bLoadWebApp
36790>>>>>        End
36790>>>>>>
36790>>>>>        
36790>>>>>        Get phoSessionDD to hoSessionDD
36791>>>>>        Get phoUserDD to hoUserDD
36792>>>>>        
36792>>>>>        Get pbLogWebSession to bLogWebSession
36793>>>>>        Get peLoginMode to eLoginMode
36794>>>>>        
36794>>>>>        // for this object, you can only disable logging if login completely is disabled
36794>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
36796>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
36797>>>>>>
36797>>>>>            Function_Return False
36798>>>>>        End
36798>>>>>>
36798>>>>>
36798>>>>>        //  Clear session properties
36798>>>>>        Set psSessionKey to ""
36799>>>>>        Send UpdateSessionProperties True
36800>>>>>        
36800>>>>>        If not bLogWebSession Begin
36802>>>>>            Forward Get ValidateSession sSessionKey to bResult
36804>>>>>            Function_Return bResult
36805>>>>>        End        
36805>>>>>>
36805>>>>>        
36805>>>>>        Move False to bResult
36806>>>>>        Get piSessionTimeout to iSessionTimeout 
36807>>>>>        
36807>>>>>        //  Check if session exists
36807>>>>>        Send Clear of hoSessionDD
36808>>>>>        Move sSessionKey to WebAppSession.SessionKey
36809>>>>>        Send Find of hoSessionDD EQ Index.1
36810>>>>>            
36810>>>>>        If (Found) Begin
36812>>>>>            //  Calculate timespan between now and last access time
36812>>>>>            Move (CurrentDateTime()) to dtCurrent
36813>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
36814>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
36815>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
36816>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
36817>>>>>            
36817>>>>>            //  Check if session didn't time out
36817>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
36819>>>>>                Forward Get ValidateSession sSessionKey to bResult
36821>>>>>                   
36821>>>>>                If (bResult) Begin
36823>>>>>                    //  Update session record
36823>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
36824>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
36825>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
36826>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
36827>>>>>                    Get Request_Validate of hoSessionDD to iErr
36828>>>>>                    If (iErr) Begin
36830>>>>>                        // this should not happen. If it does its a programming error
36830>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36831>>>>>>
36831>>>>>                        Function_Return False
36832>>>>>                    End
36832>>>>>>
36832>>>>>                    Send Request_Save of hoSessionDD
36833>>>>>                    
36833>>>>>                    //  Update user properties
36833>>>>>                    Send UpdateSessionProperties False
36834>>>>>                End
36834>>>>>>
36834>>>>>            End
36834>>>>>>
36834>>>>>            Else Begin
36835>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
36835>>>>>                Get pbCreatingNewSession to bCreatingNewSession
36836>>>>>                
36836>>>>>                If (not(bCreatingNewSession)) Begin
36838>>>>>                    If (not(bLoadWebApp)) Begin
36840>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
36841>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
36842>>>>>>
36842>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
36843>>>>>                    End
36843>>>>>>
36843>>>>>                    Else Begin
36844>>>>>                        Set pbCreatingNewSession to True                    
36845>>>>>                        Get RecreateSession of ghoWebApp to bResult 
36846>>>>>                        Set pbCreatingNewSession to False                        
36847>>>>>                    End
36847>>>>>>
36847>>>>>                End
36847>>>>>>
36847>>>>>            End
36847>>>>>>
36847>>>>>        End
36847>>>>>>
36847>>>>>        Else Begin
36848>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
36849>>>>>>
36849>>>>>        End
36849>>>>>>
36849>>>>>        
36849>>>>>        Function_Return bResult
36850>>>>>    End_Function
36851>>>>>    
36851>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36853>>>>>        If (not(pbPasswordHashing(Self))) Begin
36855>>>>>            Move sPassword to sHash
36856>>>>>            Function_Return True
36857>>>>>        End
36857>>>>>>
36857>>>>>        
36857>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
36859>>>>>            Function_Return False
36860>>>>>        End
36860>>>>>>
36860>>>>>        Move ("V1$" + sHash) to sHash
36861>>>>>        Function_Return True
36862>>>>>    End_Function
36863>>>>>    
36863>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
36865>>>>>        If (not(pbPasswordHashing(Self))) Begin
36867>>>>>            Move False to bShouldUpgrade
36868>>>>>            Function_Return (sUserPassword = sEnteredPassword)
36869>>>>>        End
36869>>>>>>
36869>>>>>        
36869>>>>>        String sVersion
36869>>>>>        Move (Left(sUserPassword, 3)) to sVersion
36870>>>>>        If (sVersion = "V1$") Begin
36872>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
36875>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
36876>>>>>        End
36876>>>>>>
36876>>>>>        Else Begin
36877>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
36880>>>>>            Function_Return False
36881>>>>>        End
36881>>>>>>
36881>>>>>    End_Function
