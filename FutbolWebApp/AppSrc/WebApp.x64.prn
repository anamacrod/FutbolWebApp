36687>>>>>    Function CreateSession String sRemoteAddress Returns String
36689>>>>>        String sSessionKey
36689>>>>>        Integer iErr
36689>>>>>        Boolean bLogWebSession
36689>>>>>        Handle hoSessionDD       
