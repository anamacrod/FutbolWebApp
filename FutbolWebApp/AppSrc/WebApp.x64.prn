36882>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
36884>>>>>        Handle hoUserDD
36884>>>>>        Integer iErr
36884>>>>>        Get phoUserDD to hoUserDD
36885>>>>>        
36885>>>>>        //  Find the user
36885>>>>>        Send Clear of hoUserDD
36886>>>>>        Move sLoginName to WebAppUser.LoginName
36887>>>>>        Send Find of hoUserDD EQ Index.1
36888>>>>>        If (Found) Begin
36890>>>>>            Send Clear of hoUserDD
36891>>>>>            Function_Return False
36892>>>>>        End
36892>>>>>>
36892>>>>>        
36892>>>>>        Send Clear of hoUserDD
36893>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
36894>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
36895>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
36897>>>>>            Send Clear of hoUserDD
36898>>>>>            Function_Return False
36899>>>>>        End
36899>>>>>>
36899>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
36900>>>>>        Get Request_Validate of hoUserDD to iErr
36901>>>>>        If (iErr) Begin
36903>>>>>            Send Clear of hoUserDD
36904>>>>>            Function_Return False
36905>>>>>        End
36905>>>>>>
36905>>>>>        
36905>>>>>        Send Request_Save of hoUserDD
36906>>>>>        Function_Return (not(Err))
36907>>>>>    End_Function
36908>>>>>    
36908>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
36910>>>>>        String sSessionKey sUserPassword
36910>>>>>        Handle hoSessionDD hoUserDD
36910>>>>>        Boolean bMatch bUpgrade
36910>>>>>        
36910>>>>>        Get phoSessionDD to hoSessionDD
36911>>>>>        Get phoUserDD to hoUserDD
36912>>>>>        Integer iErr eLoginMode
36912>>>>>        
36912>>>>>        // Refind session record
36912>>>>>        Get psSessionKey to sSessionKey
36913>>>>>        Send Clear of hoSessionDD
36914>>>>>        Move sSessionKey to WebAppSession.SessionKey
36915>>>>>        Send Find of hoSessionDD EQ Index.1
36916>>>>>        
36916>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
36918>>>>>            Get peLoginMode to eLoginMode
36919>>>>>            
36919>>>>>            //  Find the user
36919>>>>>            Move sLoginName to WebAppUser.LoginName
36920>>>>>            Send Find of hoUserDD EQ Index.1
36921>>>>>            
36921>>>>>            // Check username and password
36921>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
36923>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
36924>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
36925>>>>>                
36925>>>>>                If (bMatch) Begin
36927>>>>>                    // Store the login
36927>>>>>                    If (bUpgrade) Begin
36929>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
36930>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
36933>>>>>                    End
36933>>>>>>
36933>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
36934>>>>>                    Get Request_Validate of hoSessionDD to iErr
36935>>>>>                    If (iErr) Begin
36937>>>>>                        // this should not happen. If it does its a programming error
36937>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
36938>>>>>>
36938>>>>>                        Function_Return False
36939>>>>>                    End
36939>>>>>>
36939>>>>>                    
36939>>>>>                    Send Request_Save of hoSessionDD
36940>>>>>                    
36940>>>>>                    // Update session properties
36940>>>>>                    Send UpdateSessionProperties False
36941>>>>>                    Send NotifyChangeRights
36942>>>>>                    Function_Return True
36943>>>>>                End
36943>>>>>>
36943>>>>>                Else Begin
36944>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
36944>>>>>                    Send Clear of hoUserDD
36945>>>>>                End
36945>>>>>>
36945>>>>>            End
36945>>>>>>
36945>>>>>            Else Begin
36946>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
36946>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
36947>>>>>            End
36947>>>>>>
36947>>>>>        End
36947>>>>>>
36947>>>>>        Else Begin
36948>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
36948>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
36949>>>>>        End
36949>>>>>>
36949>>>>>          
36949>>>>>        Function_Return False
36950>>>>>    End_Function
