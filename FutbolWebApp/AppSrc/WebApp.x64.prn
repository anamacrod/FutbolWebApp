37116>>>    
37116>>>    Procedure DoLogin
37119>>>        String sLoginName sPassword sPrevStateHash
37119>>>        Boolean bResult
37119>>>        
37119>>>        WebGet psValue of oLoginName to sLoginName
37120>>>        WebGet psValue of oPassword to sPassword
37121>>>        
37121>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37122>>>        
37122>>>        If (bResult) Begin
37124>>>            Send Hide of oLogin
37125>>>            Send ShowHeader of ghoWebApp
37126>>>            WebSet psCSSClass of ghoWebApp to ""
37127>>>            
37127>>>            WebGet psPrevStateHash to sPrevStateHash
37128>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37129>>>            
37129>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37129>>>            WebSet psValue of oLoginName to ""
37130>>>            WebSet psValue of oPassword  to ""
37131>>>            WebSet pbVisible of oWarning to False
37132>>>        End
37132>>>>
37132>>>        Else Begin
37133>>>            WebSet pbVisible of oWarning to True
37134>>>        End
37134>>>>
37134>>>    End_Procedure
37135>>>    
37135>>>    Procedure OnSubmit
37138>>>        Send DoLogin
37139>>>    End_Procedure
37140>>>    
37140>>>    Procedure OnLoad
37143>>>        String sPrevStateHash sView
37143>>>        
37143>>>        Forward Send OnLoad
37145>>>        
37145>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
37145>>>        Get StateHash of ghoWebApp to sPrevStateHash
37146>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37147>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37149>>>            WebSet psPrevStateHash to sPrevStateHash
37150>>>        End
37150>>>>
37150>>>        
37150>>>    End_Procedure
37151>>>    
37151>>>    Procedure OnBeforeShow
37154>>>        //  Hide header & apply nice background style
37154>>>        Send HideHeader to ghoWebApp
37155>>>        WebSet psCSSClass of ghoWebApp to "LoginBackground"
37156>>>    End_Procedure
37157>>>    
37157>>>End_Object
