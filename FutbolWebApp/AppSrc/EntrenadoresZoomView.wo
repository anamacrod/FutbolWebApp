Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use centrenadorDataDictionary.dd

Object oEntrenadoresZoomView is a cWebView
    Set piWidth to 600
    Set psCaption to "Ficha de Entrenador (Mantenimiento)"
    Set peLayoutType to ltGrid
    Set piColumnCount to 12

    // Declaración del Diccionario de Datos
    Object oEntrenador_DD is a centrenadorDataDictionary
    End_Object
    
    Set Main_DD to oEntrenador_DD
    Set Server to oEntrenador_DD

    // Panel principal con los campos de entrada
    Object oWebMainPanel is a cWebPanel
        Set peLayoutType to ltGrid
        Set piColumnCount to 12
        //Set piColumnSpan to 12

        Object oIdForm is a cWebForm
            Entry_Item entrenador.ID
            Set psCaption to "ID:"
            Set piColumnSpan to 4
            Set pbEnabled to False
        End_Object

        Object oNombreForm is a cWebForm
            Entry_Item entrenador.Nombre
            Set psCaption to "Nombre:"
            Set piColumnSpan to 8
        End_Object

        Object oApellidoForm is a cWebForm
            Entry_Item entrenador.Apellido
            Set psCaption to "Apellido:"
            Set piColumnSpan to 12
        End_Object

        Object oNacionalidadForm is a cWebForm
            Entry_Item entrenador.Nacionalidad
            Set psCaption to "Nacionalidad:"
            Set piColumnSpan to 12
        End_Object

        Object oEquipoIdForm is a cWebForm
            Entry_Item entrenador.EquipoID
            Set psCaption to "ID Equipo:"
            Set piColumnSpan to 4
        End_Object
    End_Object

End_Object