Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cjugadorDataDictionary.dd

Object oJugadoresZoomView is a cWebView
    Set piWidth to 600
    Set psCaption to "Ficha de Jugador (Mantenimiento)"
    Set peLayoutType to ltGrid
    Set piColumnCount to 12

    // Declaración del Diccionario de Datos de Jugador
    Object oJugador_DD is a cjugadorDataDictionary
    End_Object
    
    Set Main_DD to oJugador_DD
    Set Server to oJugador_DD

    // Panel principal con los campos de entrada para jugadores
    Object oWebMainPanel is a cWebPanel
        Set peLayoutType to ltGrid
        Set piColumnCount to 12
        Set piColumnSpan to 12

        Object oIdForm is a cWebForm
            Entry_Item jugador.ID
            Set psCaption to "ID:"
            Set piColumnSpan to 4
            Set pbEnabled to False
        End_Object

        Object oNombreForm is a cWebForm
            Entry_Item jugador.Nombre
            Set psCaption to "Nombre:"
            Set piColumnSpan to 8
        End_Object

        Object oApellidoForm is a cWebForm
            Entry_Item jugador.Apellido
            Set psCaption to "Apellido:"
            Set piColumnSpan to 12
        End_Object

        Object oNacionalidadForm is a cWebForm
            Entry_Item jugador.Nacionalidad
            Set psCaption to "Nacionalidad:"
            Set piColumnSpan to 12
        End_Object

        Object oEquipoIdForm is a cWebForm
            Entry_Item jugador.EquipoID
            Set psCaption to "ID Equipo:"
            Set piColumnSpan to 4
        End_Object
    End_Object

End_Object