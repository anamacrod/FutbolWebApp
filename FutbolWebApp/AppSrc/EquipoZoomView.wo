Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cequipoDataDictionary.dd
Use cligaDataDictionary.dd

Object oEquipoZoomView is a cWebView
    Set piWidth to 600
    Set psCaption to "Ficha de Equipo (Mantenimiento)"
    Set peLayoutType to ltGrid
    Set piColumnCount to 12
    Set peViewType to vtZoom
    
    //sprint 2//
    
    Object oLiga_DD is a cligaDataDictionary
    End_Object
    
    //

    // Declaración del Diccionario de Datos de Equipo
    Object oEquipo_DD is a cequipoDataDictionary
        Set DDO_Server to oLiga_DD
    End_Object
    
    Set Main_DD to oEquipo_DD
    Set Server to oEquipo_DD

    // Panel principal con los campos de entrada para equipos
    Object oWebMainPanel is a cWebPanel
        Set peLayoutType to ltGrid
        Set piColumnCount to 12
        //Set piColumnSpan to 12

        Object oIdForm is a cWebForm
            Entry_Item equipo.ID
            Set psCaption to "ID:"
            Set piColumnSpan to 4
            Set pbEnabled to False
        End_Object

        Object oNombreForm is a cWebForm
            Entry_Item equipo.Nombre
            Set psCaption to "Nombre del Equipo:"
            Set piColumnSpan to 8
        End_Object

        Object oLigaIdForm is a cWebForm
            Entry_Item liga.Nombre
            Set psCaption to "Liga:"
            Set piColumnSpan to 4
            
            //2
            
            Set Server to oLiga_DD
            Set pbPromptButton to True
            Set pbServerOnPrompt to True
            WebRegisterPath ntNavigateForward oLigaView

            Procedure OnPrompt
                Send NavigatePath
            End_Procedure
            //
        End_Object
        
        //sprint 2 botones
        
        Object oEditarEquipo is a cWebButton
            Set psCaption to "Editar"
            Set piColumnSpan to 6

            Procedure OnClick
                Send ChangeEditMode of oEquipoZoomView True
            End_Procedure
        End_Object

        Object oGuardarEquipo is a cWebButton
            Set psCaption to "Guardar"
            Set piColumnSpan to 6

            Procedure OnClick
                Send Request_Save of oEquipoZoomView
            End_Procedure
        End_Object
        //
    End_Object

End_Object