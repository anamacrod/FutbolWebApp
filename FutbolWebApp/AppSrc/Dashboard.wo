Use cWebView.pkg
Use cWebPanel.pkg
Use cWebButton.pkg
Use cWebLabel.pkg


Use LigaView.wo
Use EquipoView.wo
Use EntrenadoresView.wo
Use JugadoresView.wo
Use PosicionView.wo

Object oDashboard is a cWebView
    Set psCaption to "Dashboard - Gestión de Fútbol"
    Set piWidth to 900
    Set peLayoutType to ltFlow
    Set piColumnCount to 12

    // Panel principal del Dashboard
    Object oMainPanel is a cWebPanel
        Set piColumnCount to 12
        Set psCSSClass to "DashboardContainer"

        // Título de bienvenida
        Object oWelcomeLabel is a cWebLabel
            Set psCaption to "Panel Principal de Control"
            Set piColumnSpan to 12
        End_Object

        // --- TILE: LIGAS ---
        Object oLigaTile is a cWebButton
            Set psCaption to "Ligas"
            Set piColumnSpan to 4
            Set psCSSClass to "DashboardTile TileLiga"
            
            WebRegisterPath ntNavigateBegin oLigaView
            
            Procedure OnClick
                Forward Send OnClick
                Send NavigatePath
            End_Procedure
        End_Object

        // --- TILE: EQUIPOS ---
        Object oEquipoTile is a cWebButton
            Set psCaption to "Equipos"
            Set piColumnSpan to 4
            Set psCSSClass to "DashboardTile TileEquipo"
            
            WebRegisterPath ntNavigateBegin oEquipoView
            
            Procedure OnClick
                Forward Send OnClick
                Send NavigatePath
            End_Procedure
        End_Object

        // --- TILE: ENTRENADORES ---
        Object oEntrenadorTile is a cWebButton
            Set psCaption to "Entrenadores"
            Set piColumnSpan to 4
            Set psCSSClass to "DashboardTile TileEntrenador"
            
            WebRegisterPath ntNavigateBegin oEntrenadoresView
            
            Procedure OnClick
                Forward Send OnClick
                Send NavigatePath
            End_Procedure
        End_Object

        // --- TILE: JUGADORES ---
        Object oJugadorTile is a cWebButton
            Set psCaption to "Jugadores"
            Set piColumnSpan to 6
            Set psCSSClass to "DashboardTile TileJugador"
            
            WebRegisterPath ntNavigateBegin oJugadoresView
            
            Procedure OnClick
                Forward Send OnClick
                Send NavigatePath
            End_Procedure
        End_Object

        // --- TILE: POSICIONES ---
        Object oPosicionTile is a cWebButton
            Set psCaption to "Posiciones"
            Set piColumnSpan to 6
            Set psCSSClass to "DashboardTile TilePosicion"
            
            WebRegisterPath ntNavigateBegin oPosicionView
            
            Procedure OnClick
                Forward Send OnClick
                Send NavigatePath
            End_Procedure
        End_Object

    End_Object

End_Object